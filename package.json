{
  "name": "dashcams",
  "version": "0.1.0",
  "private": true,
  "description": "Dashcam video file management CLI",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "dashcams": "./dev.cjs"
  },
  "publishConfig": {
    "bin": {
      "dashcams": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "node build.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clipanion": "^3.2.1",
    "drizzle-orm": "^0.45.3",
    "smol-toml": "^1.9.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "temporal-spec": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
